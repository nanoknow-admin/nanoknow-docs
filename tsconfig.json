{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      // Starlight internals reached by path because they are absent from its
      // package `exports`; mapped here since `baseUrl` is deprecated.
      "node_modules/*": ["./node_modules/*"]
    }
  }
}
